# Host runner configuration; keep real credentials outside source control.
CODEX_RUNNER_DATA_DIR=/var/lib/new-api-codex
CODEX_WORKER_IMAGE=new-api:codex-workspace-0.160.0
CODEX_WORKER_NETWORK=new-api-codex-workers
CODEX_RUNNER_HOST=127.0.0.1
CODEX_RUNNER_PORT=7310
CODEX_RUNNER_KEY_FILE=/etc/new-api-codex/runner-key
# server.mjs maps CODEX_API_* to the worker's NEW_API_* environment.
# Use a dedicated limited New API model token, not root's local Codex credentials.
CODEX_API_BASE_URL=https://your-new-api.example/v1
CODEX_API_KEY_FILE=/etc/new-api-codex/model-key
CODEX_MODELS=
CODEX_MAX_ACTIVE=2
CODEX_MAX_WORKSPACES=40
CODEX_IDLE_SECONDS=600
